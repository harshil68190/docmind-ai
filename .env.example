# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- Application ---
ENVIRONMENT=development
DEBUG=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-32-plus-character-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --- Database ---
# POSTGRES_HOST is "postgres" under Docker Compose (service name resolves
# via the Compose network) and "localhost" when running the backend
# directly on your machine against a local/Dockerized Postgres.
POSTGRES_USER=docmind
POSTGRES_PASSWORD=docmind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docmind_db

# --- CORS ---
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- Gemini (Milestone 4) ---
# Get a key at https://aistudio.google.com/apikey
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL_NAME=llama-3.3-70b-versatile