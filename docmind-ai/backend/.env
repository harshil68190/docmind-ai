# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- Application ---
ENVIRONMENT=development
DEBUG=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=xDNoUoxcvQxPMw6T2tCmCENTwYtIG6Er1oFStc2kxds
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --- Database ---
# POSTGRES_HOST is "postgres" under Docker Compose (service name resolves
# via the Compose network) and "localhost" when running the backend
# directly on your machine against a local/Dockerized Postgres.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=harshil_19
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docmind

# --- CORS ---
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI providers (wired up in later milestones — declared now so the
# .env shape doesn't change again mid-project) ---
# GOOGLE_API_KEY=